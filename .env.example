PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Apps Script Web App /exec URL for the join form (public write-only).
# Also pinned in netlify.toml for production builds.
# Leave blank locally to keep the join form in validate-only mode (nothing is POSTed).
PUBLIC_FORMS_API_URL=https://script.google.com/macros/s/AKfycbwchW0c5HpKBvqSuhtownO-xtqGEoo3qtjo73CSmVvQINpNptmy_DMlkb5gq36Zoun1/exec
# Write token for scripts/migrate-content.mjs only (never commit)
SANITY_API_WRITE_TOKEN=
# Optional local override: set to 1 only if you restore FS markdown collections for debugging.
# Production / Netlify must leave this unset so builds read Sanity.
# USE_FS_CONTENT=1
