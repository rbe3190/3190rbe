source "https://rubygems.org"

# Supports local Homebrew Ruby 4.x and Netlify Ruby 3.2.x
ruby ">= 3.2", "< 4.1"

gem "jekyll", "~> 4.4.1"
gem "jekyll-sitemap", "~> 1.4"
gem "jekyll-feed", "~> 0.17"
gem "jekyll-paginate", "~> 1.1"
gem "jekyll-archives", "~> 2.2"

# Pulls a modern sass-embedded / google-protobuf that supports Ruby 3.2–4.x
gem "jekyll-sass-converter", "~> 3.1"
gem "webrick", "~> 1.8"

# Ruby 3.4+/4.x no longer ship these as default gems; Jekyll still needs them.
gem "logger"
gem "csv"
gem "base64"
gem "bigdecimal"
