{
  "name": "rotaractblreast",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/sync-pagefind-dev.mjs",
    "preview": "astro preview",
    "pagefind:sync": "node scripts/sync-pagefind-dev.mjs",
    "astro": "astro",
    "migrate": "node --env-file=.env scripts/migrate-content.mjs",
    "repair:studio": "node --env-file=.env scripts/repair-studio-data.mjs",
    "qa": "bash scripts/qa-astro.sh"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^6.0.0",
    "@sanity/astro": "^3.5.0",
    "@sanity/client": "^7.14.1",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "^3.99.0",
    "astro": "^5.5.0",
    "easymde": "^2.21.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "sanity": "^3.99.0",
    "sanity-plugin-markdown": "^9.0.9",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "@sanity/client": "^7.14.1",
    "sanity": "$sanity"
  }
}
