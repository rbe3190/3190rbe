---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---
{
  crumbs.length > 0 && (
    <nav class="wrap py-4 text-sm text-on-surface-variant" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <li aria-hidden="true">/</li>}
            <li
              class={
                c.href ? undefined : "text-on-surface font-medium truncate max-w-[16rem]"
              }
              aria-current={c.href ? undefined : "page"}
            >
              {c.href ? (
                <a href={c.href} class="hover:text-primary">
                  {c.label}
                </a>
              ) : (
                c.label
              )}
            </li>
          </>
        ))}
      </ol>
    </nav>
  )
}
