---
import type { SiteSettings } from "../lib/types";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
const year = new Date().getFullYear();
const social = settings.siteSocial;
---
<footer class="bg-inverse-surface text-inverse-on-surface mt-auto">
  <div class="wrap py-12 md:py-16">
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="col-span-2 lg:col-span-4">
        <a href="/" class="inline-block mb-4">
          <img
            src="/images/site/footer-logo.png"
            alt="Rotaract Bangalore East"
            class="h-12 w-auto"
            width="160"
            height="48"
            loading="lazy"
          />
        </a>
        <p class="text-sm text-inverse-on-surface/80 mb-4 max-w-xs">
          District 3191 · Sponsored by Rotary Bangalore East. UNITE. RISE. EMPOWER.
        </p>
        <div class="flex gap-3">
          {
            social.instagram && (
              <a
                class="touch-target inline-flex items-center justify-center hover:text-primary-container"
                href={social.instagram}
                target="_blank"
                rel="noopener"
                aria-label="Instagram"
              >
                <SocialIcon network="instagram" />
              </a>
            )
          }
          {
            social.facebook && (
              <a
                class="touch-target inline-flex items-center justify-center hover:text-primary-container"
                href={social.facebook}
                target="_blank"
                rel="noopener"
                aria-label="Facebook"
              >
                <SocialIcon network="facebook" />
              </a>
            )
          }
          {
            social.linkedin && (
              <a
                class="touch-target inline-flex items-center justify-center hover:text-primary-container"
                href={social.linkedin}
                target="_blank"
                rel="noopener"
                aria-label="LinkedIn"
              >
                <SocialIcon network="linkedin" />
              </a>
            )
          }
          {
            social.twitter && (
              <a
                class="touch-target inline-flex items-center justify-center hover:text-primary-container"
                href={social.twitter}
                target="_blank"
                rel="noopener"
                aria-label="X (Twitter)"
              >
                <SocialIcon network="twitter" />
              </a>
            )
          }
          {
            social.youtube && (
              <a
                class="touch-target inline-flex items-center justify-center hover:text-primary-container"
                href={social.youtube}
                target="_blank"
                rel="noopener"
                aria-label="YouTube"
              >
                <SocialIcon network="youtube" />
              </a>
            )
          }
        </div>
      </div>
      <div class="col-span-1 lg:col-span-2">
        <h2 class="font-display font-semibold text-white mb-4">Explore</h2>
        <ul class="space-y-2 text-sm text-inverse-on-surface/80">
          <li><a href="/about/" class="hover:text-primary-container">About</a></li>
          <li><a href="/news/" class="hover:text-primary-container">News</a></li>
          <li><a href="/causes/" class="hover:text-primary-container">Causes</a></li>
          <li><a href="/events/" class="hover:text-primary-container">Events</a></li>
          <li><a href="/join/" class="hover:text-primary-container">Join Us</a></li>
        </ul>
      </div>
      <div class="col-span-1 lg:col-span-3">
        <h2 class="font-display font-semibold text-white mb-4">Tools &amp; legal</h2>
        <ul class="space-y-2 text-sm text-inverse-on-surface/80">
          <li><a href="/search/" class="hover:text-primary-container">Search</a></li>
          <li><a href="/brandkit/" class="hover:text-primary-container">Brand Kit</a></li>
          <li><a href="/privacy/" class="hover:text-primary-container">Privacy</a></li>
          <li><a href="/terms/" class="hover:text-primary-container">Terms</a></li>
        </ul>
      </div>
      <div class="col-span-2 lg:col-span-3">
        <h2 class="font-display font-semibold text-white mb-4">Contact</h2>
        <ul class="space-y-2 text-sm text-inverse-on-surface/80">
          <li>{settings.location}</li>
          <li>
            <a class="hover:text-primary-container" href={`mailto:${settings.email}`}>{settings.email}</a>
          </li>
          <li>
            <a class="hover:text-primary-container" href={`tel:${settings.phone.replace(/\s/g, "")}`}
              >{settings.phone}</a
            >
          </li>
          <li><a href="/contact/" class="hover:text-primary-container">Contact →</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap py-5 flex flex-col sm:flex-row justify-between gap-2 text-xs text-inverse-on-surface/60">
      <p>&copy; {year} Rotaract Bangalore East. All rights reserved.</p>
      <p>RI District 3191</p>
    </div>
  </div>
</footer>
