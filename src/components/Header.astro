---
import type { NavItem } from "../lib/types";

interface Props {
  nav: NavItem[];
  currentPath: string;
}

const { nav, currentPath } = Astro.props;

function withSlash(url: string) {
  if (!url || url.startsWith("http") || url.startsWith("mailto:") || url.startsWith("#")) return url;
  if (url === "/") return "/";
  return url.endsWith("/") ? url : `${url}/`;
}

function isActive(url: string) {
  const u = withSlash(url).replace(/\/$/, "") || "/";
  const p = currentPath.replace(/\/$/, "") || "/";
  if (u === "/") return p === "/";
  return p === u || p.startsWith(u + "/");
}
---
<header class="sticky top-0 z-50 bg-surface/90 backdrop-blur-md border-b border-outline-variant/30 shadow-sm">
  <div class="wrap flex justify-between items-center gap-3 h-16 md:h-20 min-w-0">
    <a
      href="/"
      class="flex items-center shrink-0"
      aria-label="Rotaract Bangalore East — UNITE · RISE · EMPOWER"
    >
      <img
        src="/images/brandkit/RBEUniteRiseEmpower-crest.png"
        alt="Rotaract Bangalore East"
        class="h-11 md:h-14 w-auto object-contain"
        width="160"
        height="100"
        decoding="async"
      />
    </a>
    <nav class="hidden lg:flex items-center lg:gap-4 xl:gap-7 min-w-0" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={withSlash(item.url)}
            class:list={[
              "font-body text-body-md py-2 transition-colors",
              isActive(item.url)
                ? "text-primary font-bold border-b-2 border-primary"
                : "text-on-surface-variant hover:text-primary",
            ]}
          >
            {item.title}
          </a>
        ))
      }
      <button
        type="button"
        class="touch-target text-on-surface-variant hover:text-primary"
        data-search-open
        aria-label="Search"
        aria-haspopup="dialog"
      >
        <span class="material-symbols-outlined" aria-hidden="true">search</span>
      </button>
      <a href="/join/" class="btn btn-primary text-sm ml-1 touch-target">Join Us</a>
    </nav>
    <div class="flex items-center gap-1 sm:gap-2 lg:hidden shrink-0">
      <button
        type="button"
        class="touch-target text-on-surface-variant hover:text-primary"
        data-search-open
        aria-label="Search"
        aria-haspopup="dialog"
      >
        <span class="material-symbols-outlined" aria-hidden="true">search</span>
      </button>
      <a href="/join/" class="btn btn-primary text-sm py-2 px-4 touch-target hidden sm:inline-flex"
        >Join</a
      >
      <button
        type="button"
        id="nav-toggle"
        class="touch-target rounded border border-outline-variant text-on-surface"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span class="material-symbols-outlined" data-icon-open>menu</span>
        <span class="material-symbols-outlined hidden" data-icon-close>close</span>
      </button>
    </div>
  </div>
  <nav
    id="mobile-nav"
    class="lg:hidden hidden border-t border-outline-variant/40 bg-surface"
    aria-label="Mobile"
  >
    <div class="wrap py-4 flex flex-col gap-1">
      {
        nav.map((item) => (
          <a
            href={withSlash(item.url)}
            class:list={[
              "rounded px-3 py-3 min-h-11 font-medium",
              isActive(item.url)
                ? "bg-primary-container/20 text-primary"
                : "text-on-surface hover:bg-surface-container",
            ]}
          >
            {item.title}
          </a>
        ))
      }
      <a href="/join/" class="btn btn-primary mt-3 justify-center touch-target">Join Us</a>
      <a
        href="/brandkit/"
        class="px-3 py-3 min-h-11 flex items-center text-sm text-on-surface-variant"
        >Brand Kit</a
      >
      <a
        href="/search/"
        class="px-3 py-3 min-h-11 flex items-center text-sm text-on-surface-variant"
        >Search</a
      >
    </div>
  </nav>
</header>
