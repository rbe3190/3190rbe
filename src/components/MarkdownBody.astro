---
import { renderMarkdown } from "@/lib/markdown";

interface Props {
  markdown: string;
  class?: string;
}
const { markdown, class: className = "prose-rbe" } = Astro.props;
const html = renderMarkdown(markdown || "");
---
{
  className ? (
    <div class={className} set:html={html} />
  ) : (
    <div set:html={html} />
  )
}
