---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  showSearchLink?: boolean;
  /** When false, skip slider-4.jpg background (detail pages). */
  background?: boolean;
  hideTitle?: boolean;
}

const {
  title,
  eyebrow,
  lead,
  showSearchLink = false,
  background = true,
  hideTitle = false,
} = Astro.props;
---
<section class="relative overflow-hidden bg-inverse-surface text-inverse-on-surface">
  {
    background !== false && (
      <div
        class="absolute inset-0 opacity-30 bg-cover bg-center"
        style="background-image: url('/images/site/slider-4.jpg')"
        aria-hidden="true"
      />
    )
  }
  <div
    class:list={["absolute inset-0 hero-scrim", background === false && "opacity-90"]}
    aria-hidden="true"
  >
  </div>
  <div class="wrap relative py-12 md:py-16 lg:py-20">
    {eyebrow && <p class="label-caps text-primary-fixed mb-3">{eyebrow}</p>}
    {
      !hideTitle && (
        <>
          <h1 class="font-display text-headline-lg md:text-display-hero text-white max-w-3xl">{title}</h1>
          {lead && <p class="mt-4 text-body-lg text-surface-container-highest max-w-2xl">{lead}</p>}
          {showSearchLink && (
            <p class="mt-6">
              <a
                href="/search/"
                class="text-sm font-semibold text-primary-fixed hover:underline underline-offset-4"
              >
                Search the site →
              </a>
            </p>
          )}
        </>
      )
    }
  </div>
</section>
