---
interface Props {
  page: number;
  totalPages: number;
  /** Path for page 1 (trailing slash). Default /news/ */
  basePath?: string;
  /** Builder for page N>1 paths. Default /news/page-N/ */
  pageHref?: (n: number) => string;
}

const {
  page,
  totalPages,
  basePath = "/news/",
  pageHref = (n: number) => `/news/page-${n}/`,
} = Astro.props;

const prevHref = page <= 1 ? null : page === 2 ? basePath : pageHref(page - 1);
const nextHref = page < totalPages ? pageHref(page + 1) : null;
---
{
  totalPages > 1 && (
    <nav class="mt-12 flex justify-center gap-2" aria-label="Pagination">
      {prevHref ? (
        <a href={prevHref} class="btn btn-outline text-sm py-2">
          Previous
        </a>
      ) : null}
      <span class="inline-flex items-center px-4 text-sm text-on-surface-variant">
        Page {page} of {totalPages}
      </span>
      {nextHref ? (
        <a href={nextHref} class="btn btn-outline text-sm py-2">
          Next
        </a>
      ) : null}
    </nav>
  )
}
