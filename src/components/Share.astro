---
import SocialIcon from "./SocialIcon.astro";
import { SITE } from "../lib/site";
import { newsTagPath } from "../lib/paths";

interface Props {
  url: string;
  title: string;
  tags?: string[];
}
const { url, title, tags = [] } = Astro.props;
const absolute = new URL(url, SITE.url).href;
const encodedUrl = encodeURIComponent(absolute);
const encodedTitle = encodeURIComponent(title);
const tagList = (tags ?? []).map(String).filter(Boolean);
---
<div class="share-bar flex flex-wrap items-center gap-3 mt-10 pt-6 border-t border-outline-variant/40">
  <span class="text-sm font-semibold text-on-surface">Share</span>

  <div class="flex flex-wrap items-center gap-2">
    <a
      class="share-icon-btn"
      target="_blank"
      rel="noopener"
      href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`}
      aria-label="Share on X"
    >
      <span class="share-icon-btn__glyph"><SocialIcon network="twitter" /></span>
    </a>
    <a
      class="share-icon-btn"
      target="_blank"
      rel="noopener"
      href={`https://facebook.com/sharer.php?u=${encodedUrl}`}
      aria-label="Share on Facebook"
    >
      <span class="share-icon-btn__glyph"><SocialIcon network="facebook" /></span>
    </a>
    <a
      class="share-icon-btn"
      target="_blank"
      rel="noopener"
      href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}`}
      aria-label="Share on LinkedIn"
    >
      <span class="share-icon-btn__glyph"><SocialIcon network="linkedin" /></span>
    </a>

    <div
      class="relative"
      data-share-menu
      data-share-url={absolute}
      data-share-title={title}
    >
      <button
        type="button"
        class="share-icon-btn share-icon-btn--primary"
        data-share-toggle
        aria-expanded="false"
        aria-haspopup="menu"
        aria-label="Share this page"
      >
        <span class="material-symbols-outlined text-[22px]" aria-hidden="true">upload</span>
      </button>

      <div
        class="share-popover hidden absolute left-0 top-full mt-2 z-[60]"
        data-share-popover
        role="menu"
        hidden
      >
        <button type="button" class="share-popover__item" data-share-native role="menuitem" hidden>
          <span class="material-symbols-outlined text-[20px] text-primary shrink-0" aria-hidden="true"
            >send</span
          >
          <span class="whitespace-nowrap">Share via device…</span>
        </button>
        <button type="button" class="share-popover__item" data-share-copy role="menuitem">
          <span class="material-symbols-outlined text-[20px] text-on-surface shrink-0" aria-hidden="true"
            >link</span
          >
          <span class="whitespace-nowrap" data-share-copy-label>Copy link</span>
        </button>
      </div>
    </div>
  </div>

  {
    tagList.length > 0 && (
      <div class="flex flex-wrap gap-2 w-full sm:w-auto sm:ml-1">
        {tagList.map((t) => (
          <a
            href={newsTagPath(t)}
            class="text-xs uppercase tracking-wider bg-primary-container/35 text-on-primary-container px-2.5 py-1 rounded-full font-semibold"
          >
            {t}
          </a>
        ))}
      </div>
    )
  }
</div>
