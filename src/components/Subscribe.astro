---
const formsApi = import.meta.env.PUBLIC_FORMS_API_URL ?? "";
---

<section class="bg-surface-container border-y border-outline-variant/40">
  <div class="wrap py-12 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
    <div>
      <p class="label-caps mb-2">Stay in the loop</p>
      <h2 class="font-display text-headline-md text-on-surface">Subscribe for updates</h2>
      <p class="text-on-surface-variant mt-1 max-w-md">
        News, events, and causes from Rotaract Bangalore East.
      </p>
    </div>

    <div class="w-full md:max-w-md">
      <form id="subscribe-form" data-api={formsApi} class="flex flex-col md:flex-row gap-3" novalidate>
        <div class="sr-only" aria-hidden="true">
          <label for="subscribe-website">Leave this field empty</label>
          <input id="subscribe-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="t" id="subscribe-t" value="" />

        <label class="sr-only" for="subscribe-email">Email</label>
        <input
          id="subscribe-email"
          type="email"
          name="email"
          placeholder="Your email…"
          autocomplete="email"
          required
          class="flex-1 min-w-0 rounded border border-outline-variant bg-surface-container-lowest px-3 py-2.5 text-on-surface focus:outline-none focus:ring-2 focus:ring-primary-container"
        />
        <button id="subscribe-submit" type="submit" class="btn btn-primary shrink-0 touch-target w-full md:w-auto">
          Subscribe
        </button>
      </form>

      <p id="subscribe-status" class="mt-2 text-sm font-medium" role="alert" tabindex="-1" hidden></p>

      <div
        id="subscribe-success"
        class="rounded-lg border border-primary-container/40 bg-primary-container/10 px-4 py-3"
        role="status"
        tabindex="-1"
        hidden
      >
        <p class="text-sm font-medium text-primary">You’re on the list</p>
        <p class="text-sm text-on-surface-variant mt-1" id="subscribe-success-lead">
          Thanks for subscribing - we’ll send news, events, and causes your way.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById("subscribe-form");
    if (!form) return;

    var emailInput = document.getElementById("subscribe-email");
    var honeypot = document.getElementById("subscribe-website");
    var submitBtn = document.getElementById("subscribe-submit");
    var statusNote = document.getElementById("subscribe-status");
    var successPanel = document.getElementById("subscribe-success");
    var successLead = document.getElementById("subscribe-success-lead");
    var stamp = document.getElementById("subscribe-t");

    var STALE_MS = 30 * 60 * 1000;

    function arm() {
      if (stamp) stamp.value = String(Date.now());
    }
    arm();

    // The API rejects stamps older than 2h. This band sits in the footer of every page,
    // so a long-idle tab is common — re-arm the clock when someone actually starts typing.
    if (emailInput) {
      emailInput.addEventListener("focus", function () {
        var age = Date.now() - (Number(stamp && stamp.value) || 0);
        if (age > STALE_MS) arm();
      });
    }
    window.addEventListener("pageshow", function (e) {
      if (e.persisted) arm();
    });

    function setStatus(text, isError) {
      if (!statusNote) return;
      statusNote.textContent = text;
      statusNote.className = "mt-2 text-sm font-medium " + (isError ? "text-error" : "text-primary");
      statusNote.hidden = false;
    }

    function showThankYou(preview) {
      if (preview && successLead) {
        successLead.textContent =
          "Preview only - nothing was sent. PUBLIC_FORMS_API_URL is not set for this build.";
      }
      form.hidden = true;
      if (statusNote) statusNote.hidden = true;
      if (successPanel) {
        successPanel.hidden = false;
        successPanel.focus();
      }
    }

    function readJson(res) {
      // Apps Script replies 200 with a JSON body; the body carries the real signal.
      return res.text().then(function (raw) {
        try {
          return JSON.parse(raw);
        } catch (err) {
          throw new Error("Unexpected response from the server.");
        }
      });
    }

    function isSuccess(res) {
      return Boolean(res && res.ok === true && Number(res.status) === 200);
    }

    function failMessage(res) {
      if (res && res.error) return String(res.error);
      if (res && res.status === 429) return "Too many attempts. Try again in a few minutes.";
      if (res && res.status === 403) return "Request blocked. Reload the page and try again.";
      return "Something went wrong.";
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      if (statusNote) statusNote.hidden = true;

      var email = (emailInput.value || "").trim();
      if (!email || !emailInput.checkValidity()) {
        setStatus("Please enter a valid email address.", true);
        emailInput.focus();
        return;
      }

      var apiUrl = form.getAttribute("data-api") || "";
      if (!apiUrl) {
        showThankYou(true);
        return;
      }

      var original = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = "Subscribing…";

      // text/plain keeps this a simple request, so the browser skips the CORS preflight
      // that Apps Script web apps cannot answer.
      fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify({
          form: "newsletter",
          email: email,
          website: honeypot ? honeypot.value : "",
          t: Number(stamp && stamp.value) || 0,
        }),
        redirect: "follow",
      })
        .then(readJson)
        .then(function (res) {
          if (!isSuccess(res)) throw new Error(failMessage(res));
          showThankYou(false);
        })
        .catch(function (err) {
          submitBtn.disabled = false;
          submitBtn.textContent = original;
          setStatus(err.message + " You can also email info@rotaractblreast.org.", true);
        });
    });
  })();
</script>
