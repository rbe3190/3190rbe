---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Subscribe from "../components/Subscribe.astro";
import SearchOverlay from "../components/SearchOverlay.astro";
import { SITE, PRIMARY_NAV } from "../lib/site";
import { getSiteSettings } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  noindex?: boolean;
  ogType?: "website" | "article";
  canonicalPath?: string;
  jsonLd?: object | object[] | null;
  scripts?: string[];
}

const {
  title,
  description = SITE.description,
  image,
  noindex = false,
  ogType = "website",
  canonicalPath,
  jsonLd = null,
  scripts = [],
} = Astro.props;

const settings = await getSiteSettings();
const pageTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${SITE.subtitle}`;
const path = canonicalPath ?? Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(image || SITE.ogImage, SITE.url).href;
const desc = description.replace(/<[^>]+>/g, "").slice(0, 160);
const jsonBlocks = jsonLd == null ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="shortcut icon" href="/images/site/favicon.png" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    {
      jsonBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header nav={[...PRIMARY_NAV]} currentPath={Astro.url.pathname} />
    <main id="main-content" class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Subscribe />
    <Footer settings={settings} />
    <SearchOverlay />
    <button
      type="button"
      id="scroll-top"
      class="fixed bottom-6 right-6 z-40 hidden h-11 w-11 rounded-full bg-primary-container text-on-primary-container shadow-lift items-center justify-center hover:bg-primary hover:text-on-primary"
      aria-label="Scroll to top"
    >
      <span class="material-symbols-outlined text-xl" aria-hidden="true">arrow_upward</span>
    </button>
    <script is:inline define:vars={{ gaId: SITE.gaId }}>
      document.documentElement.setAttribute("data-ga", gaId);
    </script>
    <script src="/js/site.js" defer></script>
    {scripts.map((src) => <script src={src} defer />)}
  </body>
</html>
