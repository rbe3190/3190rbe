---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found" noindex={true}>
  <section class="section-pad">
    <div class="wrap max-w-xl text-center py-16">
      <p class="label-caps mb-3">404</p>
      <h1 class="font-display text-headline-lg mb-4">Page not found</h1>
      <p class="text-on-surface-variant mb-8">That URL doesn’t exist on this site.</p>
      <a href="/" class="btn btn-primary">Back to home</a>
    </div>
  </section>
</BaseLayout>
