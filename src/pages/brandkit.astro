---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getBrandKit } from "@/lib/content";

const groups = await getBrandKit();
const total = groups.reduce((n, g) => n + g.items.length, 0);
---
<BaseLayout
  title="Brand Kit"
  description="Download official logos and brand assets for Rotaract Bangalore East, Rotary, and District 3191 partners."
  scripts={["/js/brandkit.js"]}
>
  <PageHero title="Brand Kit" />
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Brand Kit" }]} />

  <section class="section-pad">
    <div class="wrap">
      <div class="mb-8 -mx-4 px-4 md:mx-0 md:px-0">
        <div
          class="flex flex-nowrap gap-2 overflow-x-auto pb-2 snap-x"
          role="tablist"
          aria-label="Brand kit groups"
          id="brandkit-filters"
        >
          <button
            type="button"
            class="btn text-sm py-2 touch-target shrink-0 snap-start brandkit-filter is-active bg-primary-container text-on-primary-container"
            data-filter="all"
            data-label="All assets"
            aria-pressed="true">All</button
          >
          {
            groups.map((g, i) => (
              <button
                type="button"
                class="btn text-sm py-2 touch-target shrink-0 snap-start brandkit-filter btn-outline whitespace-nowrap"
                data-filter={`group-${i + 1}`}
                data-label={g.groupName}
                aria-pressed="false"
              >
                {g.groupName}
              </button>
            ))
          }
        </div>
      </div>

      <div class="mb-8">
        <h2 class="font-display text-headline-md" id="brandkit-heading">All assets</h2>
        <p class="text-sm text-on-surface-variant mt-1">
          <span id="brandkit-count">Showing {total}</span> assets
        </p>
      </div>

      <div id="brandkit-gallery" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          groups.map((g, gi) =>
            g.items.map((asset) => (
              <article class="brandkit-card card overflow-hidden flex flex-col" data-group={`group-${gi + 1}`}>
                <div
                  class:list={[
                    "aspect-square flex items-center justify-center p-6",
                    asset.white ? "bg-on-surface" : "bg-surface-muted",
                  ]}
                >
                  <img
                    src={asset.previewUrl}
                    alt={asset.title}
                    class="max-h-full max-w-full object-contain"
                    loading="lazy"
                  />
                </div>
                <div class="p-5 flex flex-col flex-1">
                  <p class="label-caps mb-2 text-[11px]">{g.groupName}</p>
                  <h3 class="font-display font-semibold text-on-surface mb-1">{asset.title}</h3>
                  <p class="text-sm text-on-surface-variant mb-4 flex-1">{asset.description}</p>
                  <div class="flex gap-3">
                    <a href={asset.fileUrl} target="_blank" rel="noopener" class="text-sm font-bold text-primary hover:underline"
                      >View</a
                    >
                    <a
                      href={asset.fileUrl}
                      download={asset.title}
                      class="text-sm font-bold text-primary hover:underline">Download</a
                    >
                  </div>
                </div>
              </article>
            )),
          )
        }
      </div>

      <p id="brandkit-empty" class="hidden text-center text-on-surface-variant py-12">No assets in this family.</p>
    </div>
  </section>
</BaseLayout>
