---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import MarkdownBody from "@/components/MarkdownBody.astro";
import Share from "@/components/Share.astro";
import { getCauses } from "@/lib/content";
import { formatDate } from "@/lib/events";

export async function getStaticPaths() {
  const causes = await getCauses();
  return causes.map((cause) => ({
    params: { slug: cause.slug },
    props: { cause },
  }));
}

const { cause } = Astro.props;
const dueLabel = cause.due ? formatDate(cause.due, { month: "short", day: "numeric", year: "numeric" }) : "Ongoing";
---
<BaseLayout
  title={cause.title}
  description={cause.description || cause.intro}
  image={cause.image}
  canonicalPath={cause.url}
>
  <PageHero title={cause.title} eyebrow={cause.focus || "Cause"} background={false} />
  <Breadcrumbs
    crumbs={[
      { label: "Home", href: "/" },
      { label: "Causes", href: "/causes/" },
      { label: cause.title },
    ]}
  />
  <article class="section-pad pt-0">
    <div class="wrap grid lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        {
          cause.image && (
            <img
              src={cause.image}
              alt={cause.title}
              class="w-full rounded-lg mb-8 aspect-[16/9] object-cover"
              fetchpriority="high"
              decoding="async"
              width="1200"
              height="675"
            />
          )
        }
        {cause.intro && <p class="text-body-lg text-on-surface-variant mb-6">{cause.intro}</p>}
        <div class="prose-rbe">
          <MarkdownBody markdown={cause.bodyMarkdown || cause.description} class="" />
        </div>
        <Share url={cause.url} title={cause.title} />
      </div>
      <aside class="lg:col-span-1">
        <div class="card p-6 sticky-panel space-y-4">
          <div class="flex justify-between text-sm">
            <span class="text-on-surface-variant">Deadline</span>
            <span class="font-medium">{dueLabel}</span>
          </div>
          {
            cause.goal != null && Number.isFinite(cause.goal) && (
              <div class="flex justify-between text-sm">
                <span class="text-on-surface-variant">Goal</span>
                <span class="font-medium">₹{cause.goal}</span>
              </div>
            )
          }
          {
            cause.progress != null && (
              <div>
                <div
                  class="progress mb-2"
                  role="progressbar"
                  aria-valuenow={cause.progress}
                  aria-valuemin="0"
                  aria-valuemax="100"
                >
                  <span style={`width: ${cause.progress}%`} />
                </div>
                <p class="text-xs text-on-surface-variant">{cause.progress}% funded</p>
              </div>
            )
          }
          {
            cause.donationLink && (
              <a
                href={cause.donationLink}
                class="btn btn-primary w-full"
                target="_blank"
                rel="noopener"
              >
                Contribute
              </a>
            )
          }
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
