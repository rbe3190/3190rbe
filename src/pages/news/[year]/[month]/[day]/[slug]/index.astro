---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import MarkdownBody from "@/components/MarkdownBody.astro";
import Share from "@/components/Share.astro";
import { getPosts } from "@/lib/content";
import { formatDate } from "@/lib/events";
import { SITE } from "@/lib/site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => {
    const parts = new Intl.DateTimeFormat("en-CA", {
      timeZone: "Asia/Kolkata",
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
    }).formatToParts(new Date(post.publishedAt));
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? "01";
    return {
      params: {
        year: get("year"),
        month: get("month"),
        day: get("day"),
        slug: post.slug,
      },
      props: {
        post,
        prev: posts[i + 1] ?? null,
        next: posts[i - 1] ?? null,
      },
    };
  });
}

const { post, prev, next } = Astro.props;
const authorName = SITE.title;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: post.title,
  datePublished: post.publishedAt,
  image: post.image ? [new URL(post.image, SITE.url).href] : undefined,
  description: post.description,
  author: { "@type": "Organization", name: SITE.title },
};
---
<BaseLayout
  title={post.title}
  description={post.description}
  image={post.image}
  ogType="article"
  canonicalPath={post.url}
  jsonLd={jsonLd}
>
  <PageHero title={post.title} eyebrow="News" hideTitle background={false} />
  <Breadcrumbs
    crumbs={[
      { label: "Home", href: "/" },
      { label: "News", href: "/news/" },
      { label: post.title },
    ]}
  />
  <article class="section-pad pt-0">
    <div class="wrap max-w-3xl">
      {
        post.image && (
          <img
            src={post.image}
            alt={post.title}
            class="w-full rounded-lg mb-8 aspect-[16/9] object-cover"
            fetchpriority="high"
            decoding="async"
            width="1200"
            height="675"
          />
        )
      }
      <p class="text-metadata text-on-surface-variant mb-2">
        {formatDate(post.publishedAt)}
        {authorName ? ` · ${authorName}` : ""}
      </p>
      <h1 class="font-display text-headline-lg text-on-surface mb-6">{post.title}</h1>
      <div class="prose-rbe">
        <MarkdownBody markdown={post.bodyMarkdown} class="" />
      </div>
      <Share url={post.url} title={post.title} tags={post.tags} />
      <div class="flex justify-between gap-4 mt-10 pt-8 border-t border-outline-variant/40">
        {prev ? <a href={prev.url} class="btn btn-outline text-sm">← Previous</a> : <span />}
        {next ? <a href={next.url} class="btn btn-outline text-sm">Next →</a> : null}
      </div>
    </div>
  </article>
</BaseLayout>
