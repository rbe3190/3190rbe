---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CardPost from "@/components/CardPost.astro";
import { getPosts } from "@/lib/content";
import { postDateParts } from "@/lib/paths";
import type { Post } from "@/lib/types";

export async function getStaticPaths() {
  const posts = await getPosts();
  const keys = new Map<string, Post[]>();
  for (const post of posts) {
    const { year, month, day } = postDateParts(post);
    const key = `${year}/${month}/${day}`;
    const list = keys.get(key) ?? [];
    list.push(post);
    keys.set(key, list);
  }
  return [...keys.entries()].map(([key, list]) => {
    const [year, month, day] = key.split("/");
    const sample = new Date(`${year}-${month}-${day}T12:00:00+05:30`);
    const title = sample.toLocaleDateString("en-GB", {
      timeZone: "Asia/Kolkata",
      day: "2-digit",
      month: "long",
      year: "numeric",
    });
    return {
      params: { year, month, day },
      props: { title, posts: list },
    };
  });
}

const { title, posts } = Astro.props;
---
<BaseLayout title={`${title} - News`} description={`News archive: ${title}`}>
  <PageHero title={title} eyebrow="News archive" />
  <Breadcrumbs
    crumbs={[{ label: "Home", href: "/" }, { label: "News", href: "/news/" }, { label: title }]}
  />
  <section class="section-pad">
    <div class="wrap">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => <CardPost post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
