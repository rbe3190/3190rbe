---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
---
<BaseLayout title="Search Results" noindex={true}>
  <PageHero
    title="Search"
    eyebrow="Find anything on the site"
    lead="News, events, causes, and key pages."
  />
  <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Search" }]} />
  <section class="section-pad">
    <div class="wrap max-w-3xl">
      <form action="/search/" method="get" role="search" class="mb-6">
        <label for="search-q" class="sr-only">Search</label>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            id="search-q"
            type="search"
            name="q"
            placeholder="Search news, events, causes, pages…"
            required
            autocomplete="off"
            class="flex-1 min-w-0 rounded border border-outline-variant bg-surface-container-lowest px-4 py-3 focus:outline-none focus:ring-2 focus:ring-primary-container"
          />
          <button type="submit" class="btn btn-primary touch-target shrink-0">Search</button>
        </div>
      </form>

      <p class="text-on-surface-variant mb-6">
        <span id="search-process">Loading</span> results
        <span id="search-query-container" class="hidden">
          for “<strong id="search-query"></strong>”
        </span>
      </p>
      <ul id="search-results" class="space-y-2"></ul>
    </div>
  </section>
  {/*
    Static site: Astro cannot bake ?q= into HTML at build time.
    Read the query from the URL in the browser. Pagefind v1 API is
    init()/search() (there is no create()).
  */}
  <script is:inline>
    (async function () {
      var params = new URLSearchParams(window.location.search);
      var q = (params.get("q") || "").trim();
      var input = document.getElementById("search-q");
      var list = document.getElementById("search-results");
      var processEl = document.getElementById("search-process");
      var queryContainer = document.getElementById("search-query-container");
      var queryEl = document.getElementById("search-query");
      if (!list) return;

      if (input && q) input.value = q;
      if (q && queryContainer && queryEl) {
        queryEl.textContent = q;
        queryContainer.classList.remove("hidden");
      }

      function setProcess(text) {
        if (processEl) processEl.textContent = text;
      }

      if (!q) {
        setProcess("Enter a");
        list.innerHTML =
          '<li class="text-on-surface-variant text-sm">Type a keyword above to search the site.</li>';
        return;
      }

      try {
        var pagefind = await import("/pagefind/pagefind.js");
        await pagefind.init();
        var search = await pagefind.search(q);
        var results = await Promise.all(
          search.results.slice(0, 30).map(function (r) {
            return r.data();
          }),
        );

        if (!results.length) {
          setProcess("No");
          list.innerHTML = '<li class="text-on-surface-variant">No results.</li>';
          return;
        }

        setProcess(String(results.length));
        list.innerHTML = results
          .map(function (r) {
            var title = (r.meta && r.meta.title) || r.url;
            var excerpt = r.excerpt || "";
            return (
              '<li class="card p-5">' +
              '<a class="font-display font-semibold text-on-surface hover:text-primary" href="' +
              r.url +
              '">' +
              title +
              "</a>" +
              (excerpt
                ? '<p class="text-sm text-on-surface-variant mt-2">' + excerpt + "</p>"
                : "") +
              "</li>"
            );
          })
          .join("");
      } catch (e) {
        console.error("Pagefind search failed:", e);
        setProcess("Unavailable");
        list.innerHTML =
          '<li class="text-on-surface-variant text-sm">Search index not found. Run <code class="text-xs">npm run build</code> once, then use <code class="text-xs">npm run preview</code> (or restart <code class="text-xs">npm run dev</code>). Production Netlify builds include Pagefind automatically.</li>';
      }
    })();
  </script>
</BaseLayout>
