---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Thank You" noindex={true}>
  <section class="section-pad">
    <div class="wrap max-w-xl text-center py-16">
      <p class="label-caps mb-3">Submission received</p>
      <h1 class="font-display text-headline-lg mb-4">Thank you</h1>
      <p class="text-on-surface-variant mb-2">Happy Rotaraction! We’ll contact you shortly.</p>
      <p class="text-sm text-on-surface-variant mb-8">Redirecting to the home page…</p>
      <a href="/" class="btn btn-primary">Back to home</a>
    </div>
  </section>
  <script is:inline>
    setTimeout(function () {
      window.location.href = "/";
    }, 5000);
  </script>
</BaseLayout>
